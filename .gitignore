# Dependencies (vendor/*.js is committed separately for the browser build)
node_modules/

# OS cruft
.DS_Store
Thumbs.db

# Editor
.vscode/
*.swp

# Python (Blender build scripts)
__pycache__/
*.pyc

# Blender autosave / backup files
*.blend1
*.blend2

# Logs
*.log
npm-debug.log*

# Generated Blender build outputs (regenerated by running the character scripts —
# see blender/blends/README.md — so they don't need to live in git)
blender/blends/*.blend

# Roblox port: generated or downloaded, not sources
roblox/sourcemap.json
roblox/globalTypes.d.luau
roblox/*.rbxl
roblox/*.rbxlx
