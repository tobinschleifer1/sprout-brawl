# Dependencies (vendor/*.js is committed separately for the browser build)
node_modules/

# OS cruft
.DS_Store
Thumbs.db

# Editor
.vscode/
*.swp

# Python (Blender build scripts)
__pycache__/
*.pyc

# Blender autosave / backup files
*.blend1
*.blend2

# Logs
*.log
npm-debug.log*

# Generated Blender build outputs (regenerated by running the character scripts —
# see blender/blends/README.md — so they don't need to live in git)
blender/blends/*.blend

# Roblox port: generated or downloaded, not sources.
# The test FIXTURES are rebuilt from web/ by roblox/check.sh on every run - about 2 MB of JSON that
# would otherwise produce a diff every time anyone ran the checks. The generated LUAU under
# roblox/src/shared/Data stays in git, because Rojo and Studio need it and neither has node.
roblox/tests/*-fixture.json
roblox/tests/trace-*.json
roblox/sourcemap.json
roblox/globalTypes.d.luau
roblox/*.rbxl
roblox/*.rbxlx

# Scratch space for throwaway measurement scripts (agents and humans both use it).
.tmp/
